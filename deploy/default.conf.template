server {
    listen 8080;
    server_name _;
    client_max_body_size 2m;

    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location / {
        proxy_pass http://line_frontend:3000;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
    }
}
